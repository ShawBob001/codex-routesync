{
  "name": "codex-routesync",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.8.2",
  "publisher": "ShawBob001",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShawBob001/codex-routesync",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/ShawBob001/codex-routesync",
  "bugs": {
    "url": "https://github.com/ShawBob001/codex-routesync/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "codex",
    "account",
    "accounts",
    "auth",
    "quota",
    "chatgpt",
    "openai",
    "api-provider",
    "token-usage",
    "conversation-history",
    "responses-api"
  ],
  "markdown": "github",
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codex-routesync",
          "title": "%viewContainer.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codex-routesync": [
        {
          "id": "codexRouteSyncRoutes",
          "name": "%view.routes.name%",
          "icon": "resources/icon.svg",
          "showCollapseAll": true
        }
      ]
    },
    "commands": [
      {
        "command": "codex-routesync.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "%command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "codex-routesync.importAccounts",
        "title": "%command.importAccounts.title%",
        "category": "%command.category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codex-routesync.addAccount",
        "title": "%command.addAccount.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "codex-routesync.addProvider",
        "title": "%command.addProvider.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "codex-routesync.reloginAccount",
        "title": "%command.reloginAccount.title%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "codex-routesync.renameAccount",
        "title": "%command.renameAccount.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "codex-routesync.removeAccount",
        "title": "%command.removeAccount.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "codex-routesync.useAccount",
        "title": "%command.useAccount.title%",
        "category": "%command.category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "codex-routesync.switchMode",
        "title": "%command.switchMode.title%",
        "category": "%command.category%",
        "icon": "$(plug)"
      },
      {
        "command": "codex-routesync.switchProvider",
        "title": "%command.switchProvider.title%",
        "category": "%command.category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "codex-routesync.refreshToken",
        "title": "%command.refreshToken.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-routesync.refreshQuota",
        "title": "%command.refreshQuota.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-routesync.refreshUsage",
        "title": "%command.refreshUsage.title%",
        "category": "%command.category%",
        "icon": "$(pulse)"
      },
      {
        "command": "codex-routesync.refreshDashboard",
        "title": "%command.refreshDashboard.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-routesync.exportAccounts",
        "title": "%command.exportAccounts.title%",
        "category": "%command.category%",
        "icon": "$(export)"
      },
      {
        "command": "codex-routesync.refreshList",
        "title": "%command.refreshList.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-routesync.refresh",
        "title": "%command.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-routesync.enableAutoSwitch",
        "title": "%command.enableAutoSwitch.title%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "codex-routesync.disableAutoSwitch",
        "title": "%command.disableAutoSwitch.title%",
        "category": "%command.category%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "codex-routesync.configureAutoSwitch",
        "title": "%command.configureAutoSwitch.title%",
        "category": "%command.category%",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "codex-routesync.reloadWindow",
        "title": "%command.reloadWindow.title%",
        "category": "%command.category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codex-routesync.repairSharedHistory",
        "title": "%command.repairSharedHistory.title%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "codex-routesync.showLogs",
        "title": "%command.showLogs.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "codex-routesync.unlockStorage",
        "title": "%command.unlockStorage.title%",
        "category": "%command.category%",
        "icon": "$(unlock)"
      },
      {
        "command": "codex-routesync.setStoragePassword",
        "title": "%command.setStoragePassword.title%",
        "category": "%command.category%",
        "icon": "$(lock)"
      },
      {
        "command": "codex-routesync.changeStoragePassword",
        "title": "%command.changeStoragePassword.title%",
        "category": "%command.category%",
        "icon": "$(key)"
      },
      {
        "command": "codex-routesync.forgetStoragePassword",
        "title": "%command.forgetStoragePassword.title%",
        "category": "%command.category%",
        "icon": "$(unlock)"
      },
      {
        "command": "codex-routesync.copyProviderField",
        "title": "%command.copyProviderField.title%",
        "category": "%command.category%",
        "icon": "$(copy)"
      },
      {
        "command": "codex-routesync.copyAccountField",
        "title": "%command.copyAccountField.title%",
        "category": "%command.category%",
        "icon": "$(copy)"
      },
      {
        "command": "codex-routesync.moveAccountToCloud",
        "title": "%command.moveAccountToCloud.title%",
        "category": "%command.category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codex-routesync.restoreCloudAccountPayload",
        "title": "%command.restoreCloudAccountPayload.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codex-routesync.moveAccountToLocal",
        "title": "%command.moveAccountToLocal.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codex-routesync.moveProviderToCloud",
        "title": "%command.moveProviderToCloud.title%",
        "category": "%command.category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codex-routesync.moveProviderToLocal",
        "title": "%command.moveProviderToLocal.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codex-routesync.removeProvider",
        "title": "%command.removeProvider.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "codex-routesync.expandAllAccounts",
        "title": "%command.expandAllAccounts.title%",
        "category": "%command.category%",
        "icon": "$(expand-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codex-routesync.openDashboard",
          "when": "view == codexRouteSyncRoutes",
          "group": "navigation@1"
        },
        {
          "command": "codex-routesync.refresh",
          "when": "view == codexRouteSyncRoutes",
          "group": "navigation@2"
        },
        {
          "command": "codex-routesync.expandAllAccounts",
          "when": "view == codexRouteSyncRoutes",
          "group": "1_accounts@2"
        },
        {
          "command": "codex-routesync.addAccount",
          "when": "view == codexRouteSyncRoutes",
          "group": "navigation@3"
        },
        {
          "command": "codex-routesync.importAccounts",
          "when": "view == codexRouteSyncRoutes",
          "group": "1_accounts@3"
        },
        {
          "command": "codex-routesync.reloadWindow",
          "when": "view == codexRouteSyncRoutes",
          "group": "3_maintenance@1"
        },
        {
          "command": "codex-routesync.enableAutoSwitch",
          "when": "view == codexRouteSyncRoutes && !codexRouteSync.autoSwitchEnabled",
          "group": "2_switching@1"
        },
        {
          "command": "codex-routesync.disableAutoSwitch",
          "when": "view == codexRouteSyncRoutes && codexRouteSync.autoSwitchEnabled",
          "group": "2_switching@1"
        },
        {
          "command": "codex-routesync.addProvider",
          "when": "view == codexRouteSyncRoutes",
          "group": "navigation@4"
        },
        {
          "command": "codex-routesync.refreshList",
          "when": "view == codexRouteSyncRoutes",
          "group": "3_maintenance@2"
        },
        {
          "command": "codex-routesync.repairSharedHistory",
          "when": "view == codexRouteSyncRoutes",
          "group": "3_maintenance@3"
        }
      ],
      "view/item/context": [
        {
          "command": "codex-routesync.useAccount",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud)",
          "group": "inline@1"
        },
        {
          "command": "codex-routesync.refreshList",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud)",
          "group": "refresh@1"
        },
        {
          "command": "codex-routesync.refreshToken",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud)",
          "group": "refresh@2"
        },
        {
          "command": "codex-routesync.refreshQuota",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud)",
          "group": "refresh@3"
        },
        {
          "command": "codex-routesync.reloginAccount",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud)",
          "group": "context@1"
        },
        {
          "command": "codex-routesync.renameAccount",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud)",
          "group": "context@2"
        },
        {
          "command": "codex-routesync.removeAccount",
          "when": "view == codexRouteSyncRoutes && (viewItem == accountLocal || viewItem == accountCloud || viewItem == accountCloudRecoverable)",
          "group": "context@3"
        },
        {
          "command": "codex-routesync.moveAccountToCloud",
          "when": "view == codexRouteSyncRoutes && viewItem == accountLocal",
          "group": "context@4"
        },
        {
          "command": "codex-routesync.restoreCloudAccountPayload",
          "when": "view == codexRouteSyncRoutes && viewItem == accountCloudRecoverable",
          "group": "context@1"
        },
        {
          "command": "codex-routesync.moveAccountToLocal",
          "when": "view == codexRouteSyncRoutes && viewItem == accountCloud",
          "group": "context@4"
        },
        {
          "command": "codex-routesync.unlockStorage",
          "when": "view == codexRouteSyncRoutes && viewItem == accountCloudLocked",
          "group": "context@1"
        },
        {
          "command": "codex-routesync.copyAccountField",
          "when": "view == codexRouteSyncRoutes && viewItem == accountCopyableField",
          "group": "context@1"
        },
        {
          "command": "codex-routesync.switchProvider",
          "when": "view == codexRouteSyncRoutes && (viewItem == providerLocal || viewItem == providerCloud)",
          "group": "inline@1"
        },
        {
          "command": "codex-routesync.moveProviderToCloud",
          "when": "view == codexRouteSyncRoutes && viewItem == providerLocal",
          "group": "context@2"
        },
        {
          "command": "codex-routesync.moveProviderToLocal",
          "when": "view == codexRouteSyncRoutes && viewItem == providerCloud",
          "group": "context@2"
        },
        {
          "command": "codex-routesync.removeProvider",
          "when": "view == codexRouteSyncRoutes && (viewItem == providerLocal || viewItem == providerCloud)",
          "group": "context@3"
        },
        {
          "command": "codex-routesync.copyProviderField",
          "when": "view == codexRouteSyncRoutes && viewItem == providerCopyableField",
          "group": "inline@1"
        },
        {
          "command": "codex-routesync.copyProviderField",
          "when": "view == codexRouteSyncRoutes && viewItem == providerCopyableField",
          "group": "context@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codex-switchbridge.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "%configuration.language.enum.auto%",
            "%configuration.language.enum.en%",
            "%configuration.language.enum.zhCn%"
          ],
          "scope": "window",
          "description": "%configuration.language.description%"
        },
        "codex-switchbridge.proxy": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "ignoreSync": true,
          "description": "%configuration.proxy.description%"
        },
        "codex-switchbridge.quotaRefreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "%configuration.quotaRefreshInterval.description%"
        },
        "codex-switchbridge.tokenAutoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.tokenAutoUpdate.description%"
        },
        "codex-switchbridge.autoSwitchOnZeroQuota": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.autoSwitchOnZeroQuota.description%"
        },
        "codex-switchbridge.autoSwitchCooldownSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 15,
          "description": "%configuration.autoSwitchCooldownSeconds.description%"
        },
        "codex-switchbridge.shareHistoryAcrossProviders": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.shareHistoryAcrossProviders.description%"
        },
        "codex-switchbridge.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showStatusBar.description%"
        },
        "codex-switchbridge.detailedPerformanceLogging": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.detailedPerformanceLogging.description%"
        },
        "codex-switchbridge.reloadWindowAfterSwitch": {
          "type": "string",
          "default": "statusBar",
          "enum": [
            "never",
            "statusBar",
            "always"
          ],
          "enumDescriptions": [
            "%configuration.reloadWindowAfterSwitch.enum.never%",
            "%configuration.reloadWindowAfterSwitch.enum.statusBar%",
            "%configuration.reloadWindowAfterSwitch.enum.always%"
          ],
          "description": "%configuration.reloadWindowAfterSwitch.description%"
        },
        "codex-switchbridge.authDirectory": {
          "type": "string",
          "default": "",
          "description": "%configuration.authDirectory.description%"
        },
        "codex-switchbridge.useDeviceAuthForLogin": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.useDeviceAuthForLogin.description%"
        },
        "codex-switchbridge.defaultSaveTarget": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "cloud"
          ],
          "enumDescriptions": [
            "%configuration.defaultSaveTarget.enum.local%",
            "%configuration.defaultSaveTarget.enum.cloud%"
          ],
          "description": "%configuration.defaultSaveTarget.description%"
        },
        "codex-switchbridge.syncedStorage": {
          "type": "object",
          "default": {
            "version": 1,
            "accounts": {},
            "accountNames": [],
            "providers": {},
            "providerNames": []
          },
          "markdownDeprecationMessage": "%configuration.syncedStorage.markdownDeprecationMessage%",
          "description": "%configuration.syncedStorage.description%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "bundle": "node ./scripts/build.mjs",
    "build": "npm run typecheck && npm run bundle",
    "dev": "node ./scripts/build.mjs --watch",
    "test": "npm run build && node ../../scripts/run-node-tests.mjs test",
    "test:visual": "npm run build && playwright test test/visual/dashboard.spec.mjs --reporter=line",
    "package": "npm --prefix ../.. run build:core && npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "publish:openvsx": "npm run package && node ./scripts/publish-openvsx.mjs",
    "prepublish:marketplace": "npm run package",
    "publish:marketplace": "node ./scripts/publish-marketplace.mjs",
    "publish:preview": "npx @vscode/vsce publish --no-dependencies --pre-release"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
