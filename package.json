{
  "name": "codex-switchbridge-monorepo",
  "version": "0.7.0",
  "private": true,
  "description": "Seamless Codex account and API-provider switching with shared local history and per-selection token usage",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShawBob001/codex-switchbridge"
  },
  "homepage": "https://github.com/ShawBob001/codex-switchbridge",
  "bugs": {
    "url": "https://github.com/ShawBob001/codex-switchbridge/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:cli && npm run build:vscode",
    "build:core": "npm run build -w packages/core",
    "build:cli": "npm run build -w packages/cli",
    "build:vscode": "npm run build -w packages/vscode",
    "test": "npm run test -w packages/core && npm run test -w packages/cli && npm run test -w packages/vscode",
    "test:migration": "python3 -m unittest scripts/test_migrate_history_provider.py -v",
    "verify": "npm test && npm run test:migration",
    "audit": "npm audit --workspaces --include-workspace-root",
    "package:vscode": "npm run package -w packages/vscode",
    "prepack:cli": "npm run prepack -w packages/cli",
    "publish:vscode:openvsx": "npm run publish:openvsx -w packages/vscode",
    "publish:vscode": "npm run publish:marketplace -w packages/vscode",
    "publish:vscode:preview": "npm run publish:preview -w packages/vscode",
    "publish:cli": "pwsh -NoLogo -NoProfile -File ./scripts/publish-cli.ps1 publish",
    "publish:cli:check": "pwsh -NoLogo -NoProfile -File ./scripts/publish-cli.ps1 check",
    "publish:cli:help": "pwsh -NoLogo -NoProfile -File ./scripts/publish-cli.ps1 help",
    "verify:publish:cli": "pwsh -NoLogo -NoProfile -File ./scripts/publish-cli.ps1 dry-run",
    "dev:core": "npm run dev -w packages/core",
    "dev:cli": "npm run dev -w packages/cli",
    "dev:vscode": "npm run dev -w packages/vscode"
  },
  "license": "MIT"
}
